    { "id": "landform.forest",    "title": "森林", "@note": "伐木，步兵隐蔽",
      "potential.food": 1.00, "potential.mat": 3.00, "moveCost": 2, "defense": 1, "buildable": true,  "color": "#4f874a" },
    { "id": "landform.hill",      "title": "丘陵", "@note": "矿脉高发，远程视野 +1",
      "potential.food": 1.00, "potential.mat": 2.00, "moveCost": 2, "defense": 1, "buildable": true,  "color": "#a08a5a" },
    { "id": "landform.mountain",  "title": "山地", "@note": "屏障，仅隘口/山谷可穿",
      "potential.food": 0.00, "potential.mat": 3.00, "moveCost": 4, "defense": 2, "buildable": false, "color": "#6d6a72" }
