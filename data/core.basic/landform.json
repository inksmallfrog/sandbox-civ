      "class.priority": 20, "class.height.min": 0, "class.height.max": 39, "class.rain.min": 23, "class.rain.max": 50 },
    { "id": "landform.forest",    "title": "森林", "@note": "伐木，步兵隐蔽",
      "potential.food": 1.00, "potential.mat": 3.00, "moveCost": 2, "defense": 1, "buildable": true,  "color": "#4f874a",
      "class.priority": 30, "class.height.min": 40, "class.height.max": 59, "class.rain.min": 23, "class.rain.max": 100 },
    { "id": "landform.hill",      "title": "丘陵", "@note": "矿脉高发，远程视野 +1",
