      "potential.food": 3.00, "potential.mat": 0.00, "moveCost": 1, "defense": 0, "buildable": true,  "color": "#8fbf5a",
      "class.priority": 10, "class.height.min": 0, "class.height.max": 39, "class.rain.min": 51, "class.rain.max": 100 },
    { "id": "landform.grassland", "title": "草原", "@note": "农牧兼备，骑兵适地",
