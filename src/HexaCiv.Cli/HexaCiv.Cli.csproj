<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>HexaCiv.Cli</RootNamespace>
    <AssemblyName>sim</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimCore\SimCore.csproj" />
    <!-- 参考 core.basic：CLI 里跑的就是「发行版同款」规则包。
         引用它的另一个作用是让 PluginHost 的程序集解析命中已加载的 core.basic，
         于是 `dotnet run` 之前不必须先 `dotnet build` 整个解决方案。 -->
    <ProjectReference Include="..\Plugins\core.basic\core.basic.csproj" />
  </ItemGroup>

</Project>
